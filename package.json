{
  "name": "@local/dsh-session-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Imports Claude Code and MiniMax Code sessions into the DSH workspace that owns their project folder, and flags each session with a [Claude Code] or [MiniMax Code] title prefix.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/borncode-app/dsh-session-sync.git" },
  "homepage": "https://github.com/borncode-app/dsh-session-sync#readme",
  "bugs": { "url": "https://github.com/borncode-app/dsh-session-sync/issues" },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sessions",
    "sync",
    "claude-code",
    "minimax"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
